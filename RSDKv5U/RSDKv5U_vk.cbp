					<Add directory="$(ExecutablePath)/" />
					<Add directory="$(DXSDK_DIR)Utilities/bin/x86/" />
					<Add directory="$(IncludePath)/" />
					<Add directory="$(DXSDK_DIR)Include/" />
					<Add directory="$(LibraryPath)/" />
					<Add directory="$(DXSDK_DIR)Lib/$(PlatformTargetAsMSBuildArchitecture)/" />
				</Compiler>
				<Linker>
					<Add library="vulkan-1.lib" />
					<Add library="libogg.lib" />
