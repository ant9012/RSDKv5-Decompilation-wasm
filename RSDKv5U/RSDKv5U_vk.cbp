	<Project>
		<Option title="RSDKv5U-vk" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug x64">
				<Option output="../build/x64/Debug/VK/RSDKv5U-vk" prefix_auto="1" extension_auto="1" />
				<Option object_output="../build/x64/Debug/v5U/VK/Intermediate/" />
				<Option deps_output="../build/x64/Debug/VK/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="-DRSDK_USE_VK" />
					<Add option="-DVULKAN_USE_GLFW" />
					<Add option="-DRETRO_REVISION=3" />
					<Add option="-D_DEBUG" />
					<Add option="-DVK_DEBUG" />
					<Add option="-D_CONSOLE" />
					<Add directory="$(VK_SDK_PATH)/include/" />
					<Add directory="../dependencies/all/tinyxml2/" />
					<Add directory="../dependencies/windows/libogg/include/" />
					<Add directory="../dependencies/windows/libtheora/include/" />
					<Add directory="../dependencies/all/" />
					<Add directory="../RSDKv5/" />
					<Add directory="../dependencies/ogl/glfw/include/" />
